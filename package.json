{
  "name": "pickle-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Pickleball assistant for group chats: holds each player's share with PayPal or Venmo and settles after the game.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "workflow": "tsx src/workflows/main.ts",
    "trigger": "tsx src/workflows/trigger.ts",
    "tick:local": "tsx scripts/run-tick-locally.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@renderinc/sdk": "^1.8.0",
    "next": "^16.4.5",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
