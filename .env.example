# Copy this file to .env and fill in the values. Never commit .env.

# PayPal sandbox app: developer.paypal.com > Apps & Credentials (Sandbox toggle on)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the same app's Webhooks section (developer.paypal.com > your app > Add webhook,
# URL https://<your-app>/api/paypal/webhook). Used to check each webhook really came from PayPal.
PAYPAL_WEBHOOK_ID=
# Optional. "on" makes games more than 3 days away save the player's PayPal at join and place the
# hold 2 days before the start. Needs Vault on the PayPal app (Accept payments > Advanced > Vault).
# Leave empty to hold at join for every game. Only the web service reads it; players who already
# saved a PayPal still get their hold if you switch it off.
DELAYED_HOLDS=
# "sandbox" or "live". Keep sandbox for the hackathon.
PAYPAL_ENV=sandbox

# Protects the capture/void test endpoints. Any long random string.
ADMIN_TOKEN=

# Claude, for reading new games from chat messages. Optional: without it a simple rule-based parser is used.
# console.anthropic.com
ANTHROPIC_API_KEY=

# Phone demo by real text through Sendblue's free sandbox (optional): judges text from their own phone.
# dashboard.sendblue.com > API keys. FROM_NUMBER is the Sendblue number shown there, like +15551234567.
# The demo page adds each judge as a contact; they text a join code once to link their phone (10 contacts on the free plan).
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=

# Postgres. Locally: your own Postgres, or the Render database's External URL.
DATABASE_URL=

# Public base URL of the app (used in links the assistant posts)
APP_URL=http://localhost:3000

# Phone demo (optional): a PayPal sandbox personal account the /demo page shows so testers can approve a hold.
# developer.paypal.com > Sandbox Accounts. Sandbox only; never a real account.
DEMO_BUYER_EMAIL=
DEMO_BUYER_PASSWORD=

# Landing page demo video (optional)
# YouTube id of the walkthrough; adds a "Watch the full video on YouTube" link to the hero player. Defaults to the submitted video (qMzS6yVeeFY).
NEXT_PUBLIC_DEMO_VIDEO_ID=
# Vertical MP4 of the phone screen recording; plays on the 3D phone's screen in the hero. Without it the screen steps through the app screens.
NEXT_PUBLIC_DEMO_VERTICAL_SRC=
